DATABASE_URL="postgresql://postgres:postgres@localhost:5432/adm_recebimentos?schema=public"
PORT=4000
JWT_SECRET="troque-por-um-segredo-forte"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="*"

# Transcrição de áudio (opcional, modo compatível mobile). Sem chave, usa Web Speech/manual.
# STT_API_KEY=
# STT_API_URL=https://api.openai.com/v1/audio/transcriptions
# STT_MODEL=whisper-1
# STT_LANGUAGE=pt

# Agradecimentos por WhatsApp (fila diária da sede).
# Evolution API (padrão):
WHATSAPP_PROVIDER=evolution
WHATSAPP_API_URL=https://seu-evolution.exemplo.com
WHATSAPP_API_KEY=token-da-instancia
WHATSAPP_INSTANCE=nome-da-instancia
WHATSAPP_NUMBER=5511999999999

# Texto opcional (placeholders: {nome}, {tipo}, {valor}):
# WHATSAPP_THANKS_MESSAGE=A paz do Senhor, {nome}! Agradecemos o seu {tipo} de {valor}. Deus abençoe!

# WhatsApp Cloud API (oficial Meta) — alternativa, só se WHATSAPP_PROVIDER=cloud:
# WHATSAPP_PROVIDER=cloud
# WHATSAPP_CLOUD_TOKEN=token-do-graph
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=id-do-numero
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TIMEOUT_MS=15000
