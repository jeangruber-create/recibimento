generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  sede
  tesoureiro_setor
  tesoureiro_congregacao
  coletor
  membro
}

enum Payment {
  dinheiro
  pix
  cartao
  outros
}

enum ClosureScope {
  congregacao
  setor
}

enum ClosureStatus {
  closed
  validated
}

enum PrestacaoStatus {
  open
  submitted
  approved
  rejected
  received
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  passwordHash       String
  name               String
  role               Role
  phone              String?
  cpf                String?   @unique
  cep                String?
  addressNumber      String?
  memberCode         String?   @unique
  profileCompletedAt DateTime?
  emailVerifiedAt    DateTime?
  verifiedVia        String?
  resetCodeHash      String?
  resetCodeExpiresAt DateTime?
  sectorId           Int?
  congregationId     Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sector         Sector?       @relation(fields: [sectorId], references: [id])
  congregation   Congregation? @relation(fields: [congregationId], references: [id])
  receipts       Receipt[]     @relation("ReceiptCreatedBy")
  personReceipts Receipt[]     @relation("ReceiptPerson")
  expenses       Expense[]

  @@index([sectorId])
  @@index([congregationId])
}

model Sector {
  id              Int              @id @default(autoincrement())
  name            String
  congregations   Congregation[]
  users           User[]
  receipts        Receipt[]
  expenses        Expense[]
  payables        Payable[]
  closures        WeekClosure[]
  prestacoes      Prestacao[]
  alerts          Alert[]
  settlementItems SettlementItem[]
  sedeFundings    SedeFunding[]
}

model Congregation {
  id             Int              @id @default(autoincrement())
  code           String
  name           String
  address        String?
  pixKey         String?
  pixKeyType     String?
  sectorId       Int
  sector         Sector           @relation(fields: [sectorId], references: [id])
  users          User[]
  receipts       Receipt[]
  expenses       Expense[]
  payables       Payable[]
  SettlementItem SettlementItem[]

  @@index([sectorId])
}

model Receipt {
  id               String    @id @default(cuid())
  number           String
  personName       String
  personMemberCode String?
  type             String
  value            Decimal   @db.Decimal(12, 2)
  payment          Payment   @default(dinheiro)
  status           String    @default("confirmado")
  reviewStatus     String    @default("reviewed") // pending|reviewed|flagged|voided
  reviewedById     Int?
  reviewedByName   String?
  reviewedAt       DateTime?
  reviewNote       String?
  source           String?
  confirmedAt      DateTime?
  confirmedByEmail String?
  date             DateTime  @default(now())
  sectorId         Int
  congregationId   Int
  createdById      Int?
  personUserId     Int?
  createdAt        DateTime  @default(now())

  sector       Sector       @relation(fields: [sectorId], references: [id])
  congregation Congregation @relation(fields: [congregationId], references: [id])
  createdBy    User?        @relation("ReceiptCreatedBy", fields: [createdById], references: [id])
  personUser   User?        @relation("ReceiptPerson", fields: [personUserId], references: [id])

  @@index([sectorId, congregationId, date])
  @@index([personMemberCode])
  @@index([personUserId])
  @@index([date])
  @@index([reviewStatus, date])
}

model Expense {
  id             String    @id @default(cuid())
  date           DateTime
  category       String
  description    String?
  value          Decimal   @db.Decimal(12, 2)
  payment        Payment   @default(dinheiro)
  status         String    @default("approved") // pending|approved|rejected|paid|voided
  reviewStatus   String    @default("approved") // pending|reviewed|approved|rejected|flagged
  reviewedById   Int?
  reviewedByName String?
  reviewedAt     DateTime?
  reviewNote     String?
  sectorId       Int
  congregationId Int
  payableId      String?
  proofName      String?
  proofType      String?
  proofSize      Int?
  proofData      String?   @db.Text
  createdByName  String?
  createdById    Int?
  createdAt      DateTime  @default(now())

  sector         Sector           @relation(fields: [sectorId], references: [id])
  congregation   Congregation     @relation(fields: [congregationId], references: [id])
  createdBy      User?            @relation(fields: [createdById], references: [id])
  payable        Payable?         @relation(fields: [payableId], references: [id])
  SettlementItem SettlementItem[]

  @@index([sectorId, congregationId, date])
  @@index([date])
  @@index([reviewStatus, date])
  @@index([status, date])
  @@index([payableId])
}

model WeekClosure {
  id             String        @id @default(cuid())
  weekStart      DateTime
  scope          ClosureScope
  sectorId       Int
  congregationId Int?
  income         Decimal       @db.Decimal(12, 2)
  expense        Decimal       @db.Decimal(12, 2)
  balance        Decimal       @db.Decimal(12, 2)
  ratio          Float
  exceeded       Boolean       @default(false)
  justification  String?
  status         ClosureStatus @default(closed)
  closedBy       String
  closedAt       DateTime      @default(now())
  validatedBy    String?
  validatedAt    DateTime?

  sector Sector @relation(fields: [sectorId], references: [id])

  @@index([weekStart, sectorId])
  @@index([weekStart, sectorId, congregationId])
}

model Prestacao {
  id            String          @id @default(cuid())
  sectorId      Int
  weekStart     DateTime
  status        PrestacaoStatus @default(open)
  declaredCash  Decimal         @default(0) @db.Decimal(12, 2)
  declaredPix   Decimal         @default(0) @db.Decimal(12, 2)
  incomeBy      Json?
  expenseBy     Json?
  note          String?
  repasseProof  Json?
  pixProofs     Json?
  submittedById Int?
  submittedAt   DateTime?
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNote    String?
  receivedById  Int?
  receivedAt    DateTime?
  receivedNote  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  sector          Sector           @relation(fields: [sectorId], references: [id])
  settlementItems SettlementItem[]

  @@unique([sectorId, weekStart])
}

model Alert {
  id             String       @id @default(cuid())
  type           String       @default("excedente_despesa")
  weekStart      DateTime
  scope          ClosureScope
  sectorId       Int
  congregationId Int?
  income         Decimal      @db.Decimal(12, 2)
  expense        Decimal      @db.Decimal(12, 2)
  ratio          Float
  limitPct       Float        @default(0.4)
  justification  String?
  read           Boolean      @default(false)
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sector Sector @relation(fields: [sectorId], references: [id])

  @@index([weekStart, sectorId])
  @@index([read])
}

// Contas a pagar / obrigações futuras (Fase 2). Ao pagar, gera Expense realizada (payableId).
model Payable {
  id               String    @id @default(cuid())
  category         String
  description      String?
  payee            String?
  nature           String? // fixa|variavel|recorrente
  amount           Decimal   @db.Decimal(12, 2)
  amountPaid       Decimal   @default(0) @db.Decimal(12, 2)
  payment          Payment   @default(dinheiro)
  dueDate          DateTime
  competenceDate   DateTime?
  status           String    @default("pending_approval") // draft|pending_approval|approved|scheduled|partially_paid|paid|canceled
  note             String?
  sectorId         Int
  congregationId   Int
  createdById      Int?
  createdByName    String?
  approvedById     Int?
  approvedByName   String?
  approvedAt       DateTime?
  paidAt           DateTime?
  canceledAt       DateTime?
  proofName        String?
  proofType        String?
  proofSize        Int?
  proofData        String?   @db.Text
  // Fatia 1 (acerto/prestação): contas básicas e envio para pagamento na sede
  isBasic          Boolean   @default(false)
  basicType        String? // energia|agua|internet|telefone|aluguel|fatura_outros
  sentToSede       Boolean   @default(false)
  sentToSedeAt     DateTime?
  sentToSedeById   Int?
  sentToSedeByName String?
  sentToSedeNote   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sector          Sector           @relation(fields: [sectorId], references: [id])
  congregation    Congregation     @relation(fields: [congregationId], references: [id])
  expenses        Expense[]
  settlementItems SettlementItem[]
  sedeFundings    SedeFunding[]

  @@index([sectorId, congregationId, dueDate])
  @@index([status, dueDate])
  @@index([dueDate])
  @@index([sentToSede, sectorId])
  @@index([isBasic, sectorId])
}

// Trilha de auditoria imutável (append-only): registra quem fez o quê, quando e sobre qual registro.
// Não possui FK para User de propósito, para sobreviver a mudanças de cadastro.
model AuditLog {
  id             Int      @id @default(autoincrement())
  at             DateTime @default(now())
  actorId        Int?
  actorName      String?
  actorRole      Role?
  action         String
  entity         String
  entityId       String?
  sectorId       Int?
  congregationId Int?
  summary        String?
  before         Json?
  after          Json?

  @@index([entity, entityId])
  @@index([at])
  @@index([sectorId])
}

// Item do acerto/prestação semanal (Fatia 1): contas quitadas, a quitar e enviadas à sede.
// Tudo previamente registrado no acerto; pagamentos pelo setor constam e ficam sujeitos à validação do admin (sede).
model SettlementItem {
  id                   String    @id @default(cuid())
  sectorId             Int
  congregationId       Int?
  weekStart            DateTime
  prestacaoId          String?
  payableId            String?
  expenseId            String?
  label                String
  category             String?
  isBasic              Boolean   @default(false)
  disposition          String    @default("a_quitar") // quitada|a_quitar|enviada_sede
  amount               Decimal   @default(0) @db.Decimal(12, 2)
  amountPaid           Decimal   @default(0) @db.Decimal(12, 2)
  amountProvisioned    Decimal   @default(0) @db.Decimal(12, 2)
  remaining            Decimal   @default(0) @db.Decimal(12, 2)
  responsible          String    @default("setor") // setor|sede
  status               String    @default("registered") // registered|paid_by_setor|paid_by_sede|canceled
  sedeValidationStatus String    @default("pending") // pending|approved|rejected|flagged|not_applicable
  sedeValidatedById    Int?
  sedeValidatedByName  String?
  sedeValidatedAt      DateTime?
  sedeValidationNote   String?
  executedById         Int?
  executedByName       String?
  executedAt           DateTime?
  note                 String?
  proofName            String?
  proofType            String?
  proofSize            Int?
  proofData            String?   @db.Text
  createdById          Int?
  createdByName        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  sector       Sector        @relation(fields: [sectorId], references: [id])
  congregation Congregation? @relation(fields: [congregationId], references: [id])
  prestacao    Prestacao?    @relation(fields: [prestacaoId], references: [id])
  payable      Payable?      @relation(fields: [payableId], references: [id])
  expense      Expense?      @relation(fields: [expenseId], references: [id])
  sedeFundings SedeFunding[]

  @@index([sectorId, weekStart])
  @@index([prestacaoId])
  @@index([payableId])
  @@index([expenseId])
  @@index([sedeValidationStatus])
  @@index([disposition, sectorId, weekStart])
}

// Provisão/repasse da sede ao setor (Fatia 1): quando o setor não tem valor para conta a quitar,
// a sede provisiona/repassa futuramente para o setor (registrado e conciliado).
model SedeFunding {
  id               String    @id @default(cuid())
  sectorId         Int
  weekStart        DateTime?
  settlementItemId String?
  payableId        String?
  amount           Decimal   @db.Decimal(12, 2)
  status           String    @default("provisioned") // provisioned|released|settled|canceled
  note             String?
  createdById      Int?
  createdByName    String?
  releasedAt       DateTime?
  settledAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sector         Sector          @relation(fields: [sectorId], references: [id])
  settlementItem SettlementItem? @relation(fields: [settlementItemId], references: [id])
  payable        Payable?        @relation(fields: [payableId], references: [id])

  @@index([sectorId, status])
  @@index([settlementItemId])
  @@index([payableId])
}
